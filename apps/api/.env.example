ENV=local
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini access
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=scam-dojo
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_KEY=

MODEL_LITE=gemini-3.8-flash
MODEL_FAST=gemini-3.8-flash
MODEL_PRO=gemini-3.8-flash
MODEL_FALLBACK=gemini-3.8-flash

# Storage
STORE=sqlite
SQLITE_PATH=./.local/dojo.sqlite
KB_PATH=./data/knowledge.sqlite
CACHE_PATH=/tmp/dojo_cache.sqlite

# Auth
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

# Features
WEBRISK_ENABLED=false
DEMO_MODE=off
TRACE_ENABLED=true
DAILY_TRAIN_TURNS=120
DAILY_CHECKS=30
DAILY_RECOVER_CALLS=20
MAX_UPLOAD_MB=20
